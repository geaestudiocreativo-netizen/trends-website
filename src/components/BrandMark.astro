---
interface Props {
  class?: string;
  label?: string;
}

const { class: className = "", label = ".G" } = Astro.props;
---

<span class:list={["brand-mark", className]} role="img" aria-label={label}>
  <span class="brand-mark__dot" aria-hidden="true"></span>
  <span class="brand-mark__glyph" aria-hidden="true">G</span>
</span>

<style>
  .brand-mark {
    display: inline-flex;
    align-items: flex-start;
    gap: 0.085em;
    color: inherit;
    font: inherit;
    line-height: 1;
    letter-spacing: inherit;
  }

  .brand-mark__dot {
    width: 0.18em;
    height: 0.18em;
    border-radius: 50%;
    background: currentColor;
    margin-top: 0.56em;
    flex: 0 0 auto;
  }

  .brand-mark__glyph {
    display: inline-block;
    font: inherit;
    line-height: 1;
    letter-spacing: inherit;
  }
</style>