---
const navItems = [
	{ label: "Servicios", href: "#servicios" },
	{ label: "Nuestras Tartas", href: "#catalogo" },
	{ label: "Sobre nosotros", href: "#sobre-nosotros" },
	{ label: "Contacto", href: "#contacto" },
] as const;
---
<header class="site-nav" aria-label="Navegacion principal">
	<div class="container site-nav__inner">
		<a class="site-nav__brand" href="#top" aria-label="Volver al inicio">
			<img src="/images/logo/logo-simple.svg" alt="Punto G" width="564" height="364" decoding="async" />
		</a>

		<nav aria-label="Secciones" class="site-nav__menu">
			{navItems.map((item) => (
				<a href={item.href}>{item.label}</a>
			))}
		</nav>
	</div>
</header>

<style>
	.site-nav {
		display: none;
	}

	@media (min-width: 901px) {
		.site-nav {
			display: block;
			position: fixed;
			top: 0;
			left: 0;
			width: 100%;
			z-index: 80;
			background: #fff;
			transition: none;
			box-shadow: none;
			border-bottom: 0;
		}

		.site-nav.is-scrolled {
			background: #fff;
		}

		.site-nav .container.site-nav__inner {
			max-width: none;
			padding-inline: clamp(12px, 1.6vw, 20px);
		}

		.site-nav__inner {
			min-height: 64px;
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 36px;
			padding-block: 8px;
		}

		.site-nav__brand {
			display: inline-flex;
			align-items: center;
			color: var(--brown);
			flex-shrink: 0;
		}

		.site-nav__brand img {
			width: auto;
			height: clamp(34px, 2.8vw, 40px);
			filter: none;
		}

		.site-nav__menu {
			display: inline-flex;
			align-items: center;
			justify-content: flex-end;
			gap: clamp(18px, 2.6vw, 38px);
			flex-wrap: wrap;
		}

		.site-nav__menu a {
			font-family: var(--font-sans);
			font-size: clamp(0.92rem, 1.15vw, 1.02rem);
			font-weight: 400;
			letter-spacing: 0.04em;
			color: var(--brown);
			opacity: 0.9;
			transition: none;
		}

		.site-nav__menu a:hover,
		.site-nav__menu a:focus-visible {
			opacity: 0.62;
		}
	}
</style>

