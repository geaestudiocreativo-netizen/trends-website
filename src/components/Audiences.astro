---
const wideImage = {
  image: "/images/services/restaurante.jpeg",
  alt: "Persona sirviendo mini postres en un plato para restaurante.",
};

const imageBase = wideImage.image.replace(/\.(?:jpe?g|png)$/i, "");
const webpSrcSet = `${imageBase}-480.webp 480w, ${imageBase}-960.webp 960w, ${imageBase}-1440.webp 1440w`;
const jpegSrcSet = `${imageBase}-480.jpg 480w, ${imageBase}-960.jpg 960w, ${imageBase}-1440.jpg 1440w`;
---
<section id="servicios" class="services-editorial section" aria-label="Servicios">
  <div class="services-editorial__text">
    <p class="services-editorial__eyebrow">ENCARGOS ESPECIALES</p>

    <p class="services-editorial__statement">
      Para ti,<br class="services-editorial__statement-break--mobile" />
      para tu restaurante<br />
      o para tu evento.
    </p>
  </div>

  <figure class="services-editorial__media">
    <picture>
      <source type="image/webp" srcset={webpSrcSet} sizes="100vw" />
      <img
        src={`${imageBase}-960.jpg`}
        srcset={jpegSrcSet}
        sizes="100vw"
        alt={wideImage.alt}
        width="6240"
        height="4160"
        loading="lazy"
        decoding="async"
      />
    </picture>
  </figure>
</section>

<style>
  .services-editorial {
    background: var(--catalogue-dark);
    padding-block: clamp(88px, 13vw, 148px);
    padding-bottom: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .services-editorial__text {
    max-width: clamp(340px, 60vw, 620px);
    padding-inline: var(--gutter);
    text-align: center;
  }

  .services-editorial__statement {
    margin: 20px 0 0;
    /* Satoshi isn't loaded in this project; falls back to Poppins Light (300), already loaded. */
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: clamp(28px, 4vw, 48px);
    line-height: 1.35;
    letter-spacing: 0;
    color: var(--cream-hero);
    white-space: nowrap;
  }

  .services-editorial__eyebrow {
    margin: 0;
    /* Satoshi isn't loaded in this project; falls back to Poppins Light (300), already loaded. */
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: 0.6rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--cream-hero);
    opacity: 0.62;
  }

  .services-editorial__media {
    margin: clamp(48px, 8vw, 80px) 0 0;
    width: 100%;
  }

  .services-editorial__media img {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (min-width: 1024px) {
    .services-editorial {
      flex-direction: row;
      align-items: center;
      min-height: clamp(420px, 38.33vw, 552px);
      margin-top: clamp(48px, 6vw, 88px);
      justify-content: flex-start;
      gap: clamp(30px, 3vw, 50px);
      position: relative;
      padding-left: 0;
      padding-right: var(--gutter);
      padding-block: clamp(32px, 4vw, 56px);
    }

    .services-editorial__text {
      flex: 0 0 auto;
      padding-inline: 0;
      text-align: left;
      order: 2;
    }

    .services-editorial__media {
      flex: 0 0 clamp(320px, 32vw, 520px);
      margin: 0;
      order: 1;
    }

    .services-editorial__media img {
      position: absolute;
      top: 0;
      bottom: 0;
      left: 0;
      width: clamp(320px, 32vw, 520px);
      height: 100%;
      object-fit: cover;
    }

    .services-editorial__statement-break--mobile {
      display: none;
    }
  }
</style>

