---
import "../styles/global.css";
import { heroImage } from "../data/site";

interface Props { title?: string; description?: string; }
const {
  title = "Tartas Punto G | Tartas de autor en Las Rozas",
  description = "Tartas de autor elaboradas artesanalmente en Las Rozas. Postres para celebrar, compartir y disfrutar en cada ocasión.",
} = Astro.props;

const canonicalUrl = "https://www.tartaspuntog.es/";
const openGraphImage = new URL(heroImage, canonicalUrl).toString();
const logoUrl = new URL("/images/logo/logo-complete.png", canonicalUrl).toString();
const phoneNumber = "+34 609 08 69 64";
const whatsappUrl = "https://wa.me/34609086964";

const businessSchema = {
  "@context": "https://schema.org",
  "@type": "Bakery",
  name: "Punto G",
  url: "https://www.tartaspuntog.es",
  logo: logoUrl,
  telephone: phoneNumber,
  areaServed: {
    "@type": "Place",
    name: "Las Rozas, Madrid, Spain",
  },
  sameAs: [whatsappUrl],
  contactPoint: [
    {
      "@type": "ContactPoint",
      telephone: phoneNumber,
      contactType: "customer service",
      areaServed: "ES",
      availableLanguage: ["es"],
      url: whatsappUrl,
    },
  ],
  address: {
    "@type": "PostalAddress",
    addressLocality: "Las Rozas",
    addressRegion: "Madrid",
    addressCountry: "ES",
  },
};
const businessSchemaJson = JSON.stringify(businessSchema);

const imagePath = (assetPath: string) => `${import.meta.env.BASE_URL}${assetPath}`;
const heroDesktopJpegSrcset = `${imagePath("images/hero/hero-1280.jpg")} 1280w, ${imagePath("images/hero/hero-1920.jpg")} 1920w, ${imagePath("images/hero/hero-2560.jpg")} 2560w`;
const heroMobileJpegSrcset = `${imagePath("images/hero/hero-mobile-640.jpg")} 640w, ${imagePath("images/hero/hero-mobile-960.jpg")} 960w, ${imagePath("images/hero/hero-mobile-1280.jpg")} 1280w`;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="theme-color" content="#f3ebe0" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/images/logo/logo-simple.svg" />
    <link rel="apple-touch-icon" href="/images/logo/logo-simple.svg" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Punto G" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={openGraphImage} />
    <meta property="og:image:alt" content="Punto G - tartas y reposteria personalizada" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={openGraphImage} />

    <script type="application/ld+json" set:html={businessSchemaJson}></script>

    <!-- Fonts: preconnect + display=swap for fast, CLS-free loading -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Krona+One&family=Montserrat:wght@500;600;700&family=Poppins:wght@300;400;500;600&display=swap"
    />

    <link
      rel="preload"
      as="image"
      href={imagePath("images/hero/hero-1920.jpg")}
      imagesrcset={heroDesktopJpegSrcset}
      imagesizes="100vw"
      media="(min-width: 641px)"
      fetchpriority="high"
    />
    <link
      rel="preload"
      as="image"
      href={imagePath("images/hero/hero-mobile-960.jpg")}
      imagesrcset={heroMobileJpegSrcset}
      imagesizes="100vw"
      media="(max-width: 640px)"
      fetchpriority="high"
    />
  </head>
  <body>
    <a class="skip-link" href="#catalogo">Saltar al catálogo</a>
    <slot />

    <footer class="site-footer">
      <div class="container">
        <img class="site-footer__logo" src="/images/logo/logo-simple.svg" alt="Punto G" width="180" height="60" decoding="async" />
        <span>© {new Date().getFullYear()}</span>
      </div>
      <div class="site-footer__credit">
        <a class="site-footer__credit-link" href="https://www.geaestudiocreativo.com" target="_blank" rel="noopener">Una web creada por <span class="site-footer__credit-name">Gea Estudio</span></a>
      </div>
    </footer>

    <style>
      .skip-link {
        position: absolute; left: 12px; top: -60px;
        background: var(--brown); color: #fff; padding: 10px 16px; border-radius: 6px;
        z-index: 100; transition: top 0.2s ease;
      }
      .skip-link:focus { top: 12px; }
      .site-footer {
        background: var(--cream);
        padding-block: 28px;
        font-size: 0.8rem;
        color: var(--muted);
        letter-spacing: 0.08em;
      }
      .site-footer .container { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
      .site-footer__logo { width: auto; height: 26px; }
      .site-footer__credit {
        margin-top: 20px;
        padding-top: 16px;
        padding-inline: clamp(20px, 5vw, 40px);
        border-top: 1px solid var(--hairline);
        font-size: 0.7rem;
        color: var(--muted);
        letter-spacing: 0.06em;
        opacity: 0.7;
        width: 100%;
        text-align: center;
      }
      .site-footer__credit-link {
        color: var(--muted);
        font-weight: 400;
        text-decoration: none;
        letter-spacing: 0.06em;
        transition: opacity 0.2s ease;
      }
      .site-footer__credit-link:hover { opacity: 0.55; text-decoration: underline; text-underline-offset: 3px; }
      .site-footer__credit-name { font-weight: 500; }
    </style>

    <script>
      // Smooth in-page scroll for the hero "Nuestras Tartas" button.
      document.querySelectorAll<HTMLAnchorElement>("[data-scroll]").forEach((el) => {
        el.addEventListener("click", (e) => {
          const target = document.querySelector(el.dataset.scroll!);
          if (!target) return;
          e.preventDefault();
          const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
          target.scrollIntoView({ behavior: reduce ? "auto" : "smooth", block: "start" });
          (target as HTMLElement).setAttribute("tabindex", "-1");
          (target as HTMLElement).focus({ preventScroll: true });
        });
      });

      // Scroll-reveal for elements marked .reveal (GPU: opacity + transform).
      const reveals = document.querySelectorAll<HTMLElement>(".reveal:not(.is-in)");
      if (reveals.length) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-in");
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: "0px 0px -8% 0px" }
        );
        reveals.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
