---
import type { Cake } from "../data/cakes";
import { SERVINGS_BY_SIZE } from "../data/cakes";

interface Props {
  cake: Cake;
  id: string;
  index: number;
}
const { cake, id, index } = Astro.props;
const num = String(index + 1).padStart(2, "0");
const imageBase = cake.image.replace(/\.(?:jpe?g|png)$/i, "");
const webpSrcSet = `${imageBase}-420.webp 420w, ${imageBase}-760.webp 760w, ${imageBase}-1080.webp 1080w, ${imageBase}-1600.webp 1600w`;
const jpegSrcSet = `${imageBase}-420.jpg 420w, ${imageBase}-760.jpg 760w, ${imageBase}-1080.jpg 1080w, ${imageBase}-1600.jpg 1600w`;
const galleryBases = cake.images && cake.images.length > 1
  ? cake.images.map((img) => img.replace(/\.(?:jpe?g|png)$/i, ""))
  : null;
---
<article class="card" data-card>
  <button
    class="card__head"
    aria-expanded="false"
    aria-controls={`panel-${id}`}
    id={`btn-${id}`}
  >
    <span class="card__number">{num}</span>

    <span class="card__media">
      {galleryBases ? (
        <>
          <span class="card__gallery" role="group" aria-label={`Galería de fotos de ${cake.name}`}>
            <span class="card__gallery-track">
              {galleryBases.map((base, i) => (
                <span class="card__slide">
                  <picture>
                    <source
                      type="image/webp"
                      srcset={`${base}-420.webp 420w, ${base}-760.webp 760w, ${base}-1080.webp 1080w, ${base}-1600.webp 1600w`}
                      sizes="100vw"
                    />
                    <img
                      src={`${base}-1080.jpg`}
                      srcset={`${base}-420.jpg 420w, ${base}-760.jpg 760w, ${base}-1080.jpg 1080w, ${base}-1600.jpg 1600w`}
                      sizes="100vw"
                      alt={`${cake.name} — foto ${i + 1} de ${galleryBases.length}`}
                      width="1080"
                      height="1350"
                      loading="eager"
                      decoding="async"
                    />
                  </picture>
                </span>
              ))}
            </span>
          </span>
          <span
            class="card__gallery-arrow card__gallery-arrow--prev"
            role="button"
            tabindex="0"
            aria-label={`Foto anterior de ${cake.name}`}
            data-dir="-1"
          >
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
              <path d="M14.5 5.5l-6.5 6.5 6.5 6.5" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
          <span
            class="card__gallery-arrow card__gallery-arrow--next"
            role="button"
            tabindex="0"
            aria-label={`Foto siguiente de ${cake.name}`}
            data-dir="1"
          >
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
              <path d="M9.5 5.5l6.5 6.5-6.5 6.5" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
          <span class="card__gallery-progress" aria-hidden="true">
            <span class="card__gallery-progress-fill"></span>
          </span>
        </>
      ) : (
        <picture>
          <source type="image/webp" srcset={webpSrcSet} sizes="100vw" />
          <img
            src={`${imageBase}-1080.jpg`}
            srcset={jpegSrcSet}
            sizes="100vw"
            alt={cake.name}
            width="1080"
            height="1350"
            loading="lazy"
            decoding="async"
          />
        </picture>
      )}
    </span>

    <span class="card__body">
      <span class="card__title">{cake.name}</span>
      {cake.description && <span class="card__desc">{cake.description}</span>}
      <span class="card__details">
        {cake.sizes && cake.sizes.length > 0 && <span class="card__details-title" role="heading" aria-level="4">Tamaños y precios</span>}
        <span class="card__details-open">[MÁS DETALLES]</span>
        <span class="card__details-close">[×]</span>
      </span>
    </span>
  </button>

  <div class="card__panel" id={`panel-${id}`} role="region" aria-labelledby={`btn-${id}`}>
    <div class="card__panel-inner">
      <div class="detail">
        {cake.sizes && cake.sizes.length > 0 && (
          <>
            <ul class="sizes">
              {cake.sizes.map((s, i) => (
                <li class="size">
                  <span class="size__label">
                    <span class="size-chip" style={`--bg:${i % 2 === 0 ? "#7B8062" : "#4A2928"};--fg:#F7F1E8`}>{s.size}</span>
                    {SERVINGS_BY_SIZE[s.size] && <span class="size__divider" aria-hidden="true">|</span>}
                    {SERVINGS_BY_SIZE[s.size] && <span class="size__note">{SERVINGS_BY_SIZE[s.size]}</span>}
                  </span>
                  <span class="size__price">{s.price}</span>
                </li>
              ))}
            </ul>
          </>
        )}

        {cake.flavors && cake.flavors.length > 0 && (
          <>
            <h4 class="detail__h">Variedades</h4>
            <ul class="detail__allergens">
              {cake.flavors.map((f) => <li>{f}</li>)}
            </ul>
          </>
        )}

        {cake.allergens && cake.allergens.length > 0 && (
          <>
            <h4 class="detail__h">Alérgenos</h4>
            <ul class="detail__allergens">
              {cake.allergens.map((a) => <li>{a}</li>)}
            </ul>
          </>
        )}

      </div>
    </div>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: transparent;
  }

  .card__head {
    display: flex;
    flex-direction: column;
    width: 100%;
    text-align: left;
    padding: 0;
  }

  .card__number {
    display: block;
    /* Satoshi isn't loaded in this project; falls back to Poppins Light (300), already loaded. */
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 300;
    letter-spacing: 0.24em;
    color: rgba(69, 41, 40, 0.5);
    margin-bottom: clamp(14px, 2vw, 20px);
  }

  .card__media {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    width: calc(100% + var(--gutter) * 2);
    margin-inline: calc(var(--gutter) * -1);
  }
  @media (min-width: 641px) {
    .card__media { aspect-ratio: 16 / 10; }
  }
  @media (min-width: 901px) {
    .card__media { aspect-ratio: 21 / 9; }
  }
  /* Grid mode: a contained product photo (matching the source images'
     natural 4:5 ratio) instead of the full-bleed banner crop above. */
  @media (min-width: 1024px) {
    .card__media {
      width: 100%;
      margin-inline: 0;
      aspect-ratio: 4 / 5;
    }
  }
  .card__media img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform 0.6s var(--ease);
    will-change: transform;
  }
  .card:hover .card__media img { transform: scale(1.03); }

  /* Editorial swipe gallery: JS-driven transform, no visible controls. */
  .card__gallery {
    display: block;
    width: 100%;
    height: 100%;
    /* Stationary clipping viewport; the track inside is what actually moves. */
    overflow: hidden;
    touch-action: pan-y;
  }
  .card__gallery-track {
    display: flex;
    width: 100%;
    height: 100%;
    transition: transform 0.4s var(--ease);
  }
  .card__slide {
    flex: 0 0 100%;
    height: 100%;
    /* Clips the hover-zoomed image to its own slide so it can't bleed into the next slide. */
    overflow: hidden;
  }

  /* Discreet swipe-progress hairline; sits over the photo, secondary to it. */
  .card__gallery-progress {
    position: absolute;
    left: 50%;
    bottom: clamp(14px, 3vw, 20px);
    transform: translateX(-50%);
    width: 40px;
    height: 2px;
    background: rgba(255, 255, 255, 0.35);
    pointer-events: none;
  }
  @media (min-width: 1024px) {
    .card__gallery-progress { height: 1px; }
  }
  .card__gallery-progress-fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: 33.333%;
    background: rgba(255, 255, 255, 0.92);
  }

  /* Desktop-only gallery controls: compact white squares over the photo. */
  .card__gallery-arrow {
    display: none;
    position: absolute;
    top: auto;
    bottom: 8px;
    z-index: 1;
    width: 20px;
    height: 20px;
    padding: 2px;
    box-sizing: border-box;
    line-height: 0;
    background: rgba(0, 0, 0, 0.4);
    color: #fff;
    cursor: pointer;
    transition: color var(--dur) var(--ease), background-color var(--dur) var(--ease);
  }
  .card__gallery-arrow[hidden] {
    display: none;
  }
  .card__gallery-arrow:hover,
  .card__gallery-arrow:focus-visible {
    color: #fff;
    background: rgba(0, 0, 0, 0.4);
  }
  .card__gallery-arrow svg { display: block; }
  .card__gallery-arrow--prev { left: 4px; }
  .card__gallery-arrow--next { right: 4px; }
  @media (min-width: 1024px) and (hover: hover) and (pointer: fine) {
    .card__gallery-arrow { display: block; }
    /* Arrows replace the progress bar as the nav cue on desktop. */
    .card__gallery-progress { display: none; }
  }

  .card__body {
    display: flex;
    flex-direction: column;
    max-width: 620px;
    padding-top: clamp(36px, 5.5vw, 56px);
  }
  @media (max-width: 640px) {
    .card__media,
    .card__body {
      width: calc(100% + var(--gutter) * 2 - 32px);
      margin-inline: calc(var(--gutter) * -1 + 16px);
    }
  }
  .card__title {
    /* Satoshi isn't loaded in this project; falls back to Poppins Light (300), already loaded. */
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: 21px;
    color: var(--catalogue-dark);
    line-height: 1.15;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .card__desc {
    display: block;
    margin-top: 4px;
    /* Uses --font-sans (Poppins Light) instead of Montserrat: Montserrat has no 300 face loaded on this site, so it would render as a synthesized medium instead of genuinely light. */
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: 14px;
    line-height: 1.6;
    color: var(--catalogue-dark);
  }

  .card__sizes-line {
    display: block;
    margin-top: 18px;
    /* Montserrat has no 300 face loaded; browser resolves to its lightest loaded weight (500). */
    font-family: "Montserrat", var(--font-sans);
    font-weight: 300;
    font-size: 10px;
    letter-spacing: 0.02em;
    color: rgba(69, 41, 40, 0.6);
  }

  .card__details {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    width: 100%;
    align-self: flex-start;
    margin-top: clamp(40px, 6vw, 56px);
    color: #8a8580;
    font-size: 0.76rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    opacity: 0.85;
    transition: opacity var(--dur) var(--ease);
  }
  @media (min-width: 1024px) {
    .card__details {
      margin-top: 8px;
    }
  }
  .card__head:hover .card__details,
  .card__head:focus-visible .card__details {
    opacity: 1;
  }
  .card__details-close { display: none; }
  .card__head[aria-expanded="true"] .card__details-open { display: none; }
  .card__head[aria-expanded="true"] .card__details-close { display: inline; }
  .card__details-title { display: none; }
  .card__head[aria-expanded="true"] .card__details {
    justify-content: space-between;
  }
  .card__head[aria-expanded="true"] .card__details-title { display: inline; }

  /* Desktop grid: reserve room for the longest description (up to 3 lines)
     so "Tamaños:" and "[VER DETALLES]" line up across cards even when one
     card's description wraps to more lines than the others. */
  @media (min-width: 1024px) {
    .card__number,
    .card__title,
    .card__desc {
      margin-left: 12px;
    }
    .card__body {
      height: 187px;
      min-height: 187px;
      padding-top: clamp(20px, 3vw, 32px);
    }
    .card__title {
      font-size: 23px;
    }
    .card__desc {
      min-height: 4.8em;
      flex: 1 1 auto;
      font-size: 15px;
    }
    .card__sizes-line {
      margin-top: 8px;
      font-size: 11px;
    }
    .card__details {
      margin-top: 2px;
      margin-left: 12px;
      width: calc(100% - 12px);
    }
  }

  /* expand */
  .card__panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows var(--dur) var(--ease);
  }
  .card__panel-inner {
    overflow: hidden;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity var(--dur) var(--ease), transform var(--dur) var(--ease);
  }
  .card__head[aria-expanded="true"] + .card__panel { grid-template-rows: 1fr; }
  .card__head[aria-expanded="true"] + .card__panel .card__panel-inner { opacity: 1; transform: none; }

  .detail {
    display: flex;
    flex-direction: column;
    max-width: 620px;
    padding: 0 0 4px;
  }
  @media (max-width: 640px) {
    .card__panel-inner {
      width: calc(100% + var(--gutter) * 2 - 32px);
      margin-inline: calc(var(--gutter) * -1 + 16px);
    }
  }
  @media (min-width: 641px) {
    .detail {
      margin-left: 12px;
    }
  }
  .card__panel-inner { background: transparent; }
  .detail__h {
    font-size: 0.7rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase;
    color: rgba(69, 41, 40, 0.5); margin-top: 16px; margin-bottom: 8px;
  }
  .sizes { display: flex; flex-direction: column; gap: 8px; margin: 16px 0 0; }
  .size { display: flex; justify-content: space-between; align-items: center; gap: 12px; font-size: 0.86rem; }
  .size__label { display: flex; align-items: center; gap: 8px; color: var(--catalogue-dark); flex-wrap: nowrap; white-space: nowrap; }
  .size__code {
    display: inline-grid; place-items: center;
    width: 20px; height: 20px; border-radius: 5px;
    background: var(--bg); color: var(--fg);
    font-size: 0.66rem; font-weight: 600; line-height: 1;
  }
  .size__note { display: inline; width: auto; font-size: 0.7rem; color: rgba(69, 41, 40, 0.6); font-style: normal; padding-left: 0; white-space: nowrap; }
  .size__divider { color: rgba(69, 41, 40, 0.45); font-size: 0.7rem; }
  .size__price { color: var(--catalogue-dark); font-weight: 600; white-space: nowrap; }

  .detail__allergens {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 0.7rem;
    line-height: 1.5;
    color: rgba(69, 41, 40, 0.62);
  }
  .detail__allergens li::before { content: "— "; }

  .detail__storage { font-size: 0.8rem; color: rgba(69, 41, 40, 0.6); line-height: 1.55; }
  .card.is-hidden { display: none; }

</style>

