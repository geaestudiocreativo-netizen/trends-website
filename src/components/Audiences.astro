---
import { waLink } from "../data/site";
import WhatsAppIcon from "./WhatsAppIcon.astro";

const editorialServices = [
  {
    title: "PARA TI",
    subtitle: "Siempre hay una buena excusa.",
    image: "/images/services/para-ti.jpeg",
    alt: "Porción de tarta servida en plato para una celebración personal.",
    align: "right",
  },
  {
    title: "RESTAURANTES",
    subtitle: "Postres para tu carta.",
    image: "/images/services/restaurante.jpeg",
    alt: "Persona sirviendo mini postres en un plato para restaurante.",
    align: "left",
  },
  {
    title: "EVENTO",
    subtitle: "Hay momentos que merecen algo más.",
    image: "/images/services/evento.jpeg",
    alt: "Preparacion artesanal de una tarta para evento.",
    align: "right",
  },
] as const;
---
<section id="servicios" class="services-editorial section" aria-labelledby="services-editorial-title">
  <div class="container services-editorial__inner">
    <h2 id="services-editorial-title" class="services-editorial__heading">Para lo que celebres</h2>
  </div>

  <div class="services-editorial__flow">
    {editorialServices.map((item, index) => (
      <article class:list={["service-spot", `service-spot--${item.align}`]}>
        <figure class="service-spot__media">
          <img src={item.image} alt={item.alt} loading={index === 0 ? "eager" : "lazy"} decoding="async" />
        </figure>
        <div class="service-spot__copy">
          <h3 class="service-spot__title">{item.title}</h3>
          <p class="service-spot__subtitle">{item.subtitle}</p>
        </div>
      </article>
    ))}
  </div>

  <div class="container services-editorial__inner">
    <a class="btn btn--gold services-editorial__cta" href={waLink()} target="_blank" rel="noopener">
      <WhatsAppIcon size={17} />
      Cuéntame tu idea
    </a>
  </div>
</section>

<style>
  .services-editorial {
    background: var(--cream-hero);
    padding-block: clamp(70px, 10vw, 120px) clamp(86px, 12vw, 140px);
  }

  .services-editorial__inner {
    display: flex;
    flex-direction: column;
  }

  .services-editorial__heading {
    max-width: 12ch;
    font-family: var(--font-sans);
    font-size: 26px;
    font-weight: 400;
    letter-spacing: 0.16em;
    line-height: 1.15;
    color: var(--olive-dark);
    text-transform: none;
  }

  .services-editorial__flow {
    margin-top: clamp(56px, 7vw, 86px);
    display: flex;
    flex-direction: column;
    gap: clamp(78px, 10vw, 126px);
  }

  .service-spot {
    --service-rule-length: clamp(34px, 5vw, 52px);
    display: grid;
    gap: clamp(16px, 2vw, 22px);
    width: 100%;
  }

  .service-spot--right {
    padding-left: var(--gutter);
    padding-right: 0;
    justify-items: end;
  }

  .service-spot--right .service-spot__copy {
    margin-left: auto;
    width: fit-content;
    max-width: min(94vw, 980px);
    align-items: flex-start;
    text-align: left;
  }

  .service-spot--left {
    padding-right: var(--gutter);
    padding-left: clamp(0px, 1.3vw, 14px);
    justify-items: start;
  }

  .service-spot__media {
    width: min(94vw, 980px);
    aspect-ratio: 3 / 2;
    overflow: hidden;
  }

  .service-spot__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  @media (min-width: 901px) {
    .services-editorial__flow {
      width: 100%;
      max-width: var(--container);
      margin-inline: auto;
      padding-inline: var(--gutter);
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: clamp(24px, 3vw, 42px);
      row-gap: 0;
      align-items: start;
    }

    .service-spot {
      min-width: 0;
      width: 100%;
      gap: 14px;
      align-content: start;
      grid-column: auto;
      grid-row: auto;
    }

    .service-spot--right,
    .service-spot--left {
      padding-left: 0;
      padding-right: 0;
      justify-items: start;
    }

    .service-spot--right {
      justify-items: end;
    }

    .service-spot__media {
      width: 100%;
    }

    .service-spot__copy,
    .service-spot--left .service-spot__copy,
    .service-spot--right .service-spot__copy {
      width: fit-content;
      max-width: none;
      margin-left: 0;
      align-items: flex-start;
      text-align: left;
    }

    .service-spot--right .service-spot__copy {
      margin-left: auto;
    }
  }

  .service-spot__copy {
    display: flex;
    flex-direction: column;
    gap: 6px;
    width: min(94vw, 980px);
  }

  .service-spot__title {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    font-family: var(--font-logo);
    font-size: 20px;
    line-height: 0.95;
    color: var(--olive-dark);
    letter-spacing: 0.09em;
    text-transform: uppercase;
    font-weight: 400;
  }

  .service-spot__title::before,
  .service-spot__title::after {
    content: "";
    display: block;
    width: var(--service-rule-length);
    height: 3px;
    border-radius: 999px;
    background: currentColor;
    opacity: 0.78;
  }

  .service-spot--right .service-spot__title::before {
    display: none;
  }

  .service-spot--left .service-spot__title::after {
    display: none;
  }

  .service-spot__subtitle {
    font-size: 11px;
    line-height: 1.35;
    letter-spacing: 0.14em;
    color: rgba(69, 41, 40, 0.42);
  }

  .service-spot--left .service-spot__subtitle {
    padding-left: calc(var(--service-rule-length) + 0.55em);
  }

  .services-editorial__cta {
    margin-top: clamp(78px, 11vw, 132px);
    width: auto;
    max-width: 100%;
    align-self: center;
    height: 46px;
    padding-inline: 22px;
    border-radius: var(--radius-btn);
    font-size: 0.9rem;
    font-weight: 400;
    letter-spacing: 0.01em;
  }

  @media (max-width: 900px) {
    .services-editorial__heading {
      max-width: 13ch;
      letter-spacing: 0.12em;
    }

    .service-spot--right {
      padding-left: clamp(20px, 5vw, 42px);
      padding-right: 0;
    }

    .service-spot--left {
      padding-right: clamp(20px, 5vw, 42px);
      padding-left: clamp(0px, 1vw, 10px);
    }

    .service-spot__media,
    .service-spot__copy {
      width: min(96vw, 760px);
    }

    .service-spot--right .service-spot__copy {
      width: fit-content;
      max-width: min(96vw, 760px);
    }
  }

  @media (max-width: 640px) {
    .services-editorial {
      padding-block: clamp(56px, 14vw, 74px) clamp(78px, 15vw, 98px);
    }

    .services-editorial__flow {
      gap: clamp(60px, 14vw, 90px);
      margin-top: clamp(44px, 10vw, 62px);
    }

    .service-spot {
      gap: 14px;
    }

    .service-spot--right {
      padding-left: clamp(12px, 3vw, 16px);
      padding-right: 0;
    }

    .service-spot--left {
      padding-right: clamp(12px, 3vw, 16px);
      padding-left: 0;
    }

    .service-spot__media {
      width: min(100%, 77vw);
      aspect-ratio: 11 / 10;
    }

    .service-spot__copy {
      width: min(100%, 96vw);
    }

    .service-spot--right .service-spot__copy {
      width: fit-content;
      max-width: 96vw;
    }

    .service-spot__subtitle {
      max-width: 18ch;
      letter-spacing: 0.14em;
      color: rgba(69, 41, 40, 0.36);
    }

    .service-spot--left .service-spot__subtitle {
      max-width: none;
      white-space: nowrap;
    }

    .services-editorial__cta {
      width: calc(100% - 32px);
      max-width: calc(100% - 32px);
      margin-top: clamp(64px, 14vw, 90px);
    }
  }
</style>
