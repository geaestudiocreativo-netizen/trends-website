---
import { site, waLink } from "../data/site";

const message = site.whatsappDefaultMessage;
const telHref = `tel:+${site.whatsappNumber}`;
---
<section id="contacto" class="special-orders" aria-labelledby="special-orders-title">
  <div class="special-orders__inner">
    <h2 class="special-orders__heading" id="special-orders-title">¿y si quiero <br class="special-orders__heading-break" /> una tarta <br class="special-orders__heading-break" /> diferente?</h2>

    <p class="special-orders__body">Para una celebración, un encargo especial o simplemente porque tienes una idea en mente.</p>

    <p class="special-orders__hint">Para pedidos y consultas, escríbenos por WhatsApp o llámanos.</p>

    <div class="special-orders__actions">
      <a class="btn btn--gold special-orders__btn" href={waLink(message)} target="_blank" rel="noopener">
        Hacer un encargo
      </a>
      <a class="btn btn--light special-orders__btn special-orders__phone-btn" href={telHref}>
        Llamar por teléfono
      </a>
    </div>

  </div>
</section>

<style>
  .special-orders {
    background: var(--cream-hero);
    padding-block: clamp(120px, 14vw, 168px);
  }

  @media (min-width: 1024px) {
    .special-orders {
      background: #ffffff;
    }
  }

  .special-orders__inner {
    max-width: 560px;
    margin-inline: auto;
    padding-inline: clamp(20px, 6vw, 40px);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .special-orders__heading {
    /* Satoshi isn't loaded in this project; falls back to Poppins Light (300), already loaded. */
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 300;
    text-transform: none;
    letter-spacing: 0.01em;
    line-height: 1.25;
    color: var(--catalogue-dark);
    margin: 0 0 28px;
  }

  @media (min-width: 1024px) {
    .special-orders__heading-break {
      display: none;
    }
  }

  @media (min-width: 1024px) {
    .special-orders__inner {
      /* Widened so the intro paragraph below has room to fit its own single-line max-width. */
      max-width: 840px;
    }
  }

  .special-orders__body,
  .special-orders__hint {
    font-family: "Montserrat", var(--font-sans);
    font-weight: 300;
    font-size: clamp(0.9rem, 1vw, 1rem);
    line-height: 1.7;
    color: var(--brown);
    opacity: 0.78;
    width: 100%;
    max-width: clamp(420px, 54vw, 640px);
    margin: 0 auto 18px;
  }

  @media (min-width: 1024px) {
    .special-orders__body {
      /* Wide enough to keep the full sentence on one line at the desktop font size. */
      max-width: 780px;
    }
  }

  .special-orders__body {
    margin-bottom: 0;
  }

  .special-orders__hint {
    margin-bottom: 36px;
  }

  .special-orders__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
  }

  .special-orders__btn {
    padding-inline: 32px;
  }

  .special-orders__phone-btn {
    background: #ffffff;
  }

  .special-orders__heading,
  .special-orders__body,
  .special-orders__hint,
  .special-orders__btn {
    clip-path: inset(100% 0 0 0);
    opacity: 0;
    transform: translate3d(0, 38px, 0);
    transition:
      clip-path 1.45s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 1.45s cubic-bezier(0.22, 1, 0.36, 1),
      transform 1.45s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .special-orders.is-visible .special-orders__heading,
  .special-orders.is-visible .special-orders__body,
  .special-orders.is-visible .special-orders__hint,
  .special-orders.is-visible .special-orders__btn {
    clip-path: inset(0 0 0 0);
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  .special-orders.is-visible .special-orders__heading { transition-delay: 0.12s; }
  .special-orders.is-visible .special-orders__body { transition-delay: 0.38s; }
  .special-orders.is-visible .special-orders__hint { transition-delay: 0.58s; }
  .special-orders.is-visible .special-orders__btn:nth-child(1) { transition-delay: 0.82s; }
  .special-orders.is-visible .special-orders__btn:nth-child(2) { transition-delay: 1s; }

  @media (prefers-reduced-motion: reduce) {
    .special-orders__heading,
    .special-orders__body,
    .special-orders__hint,
    .special-orders__btn {
      clip-path: none;
      transform: none;
      transition: none;
    }
    .special-orders__heading,
    .special-orders__btn { opacity: 1; }
    .special-orders__body,
    .special-orders__hint { opacity: 0.78; }
  }

  @media (max-width: 640px) {
    .special-orders {
      padding-block: 40px 96px;
    }
    .special-orders__heading-break {
      display: none;
    }
    .special-orders__actions {
      flex-direction: column;
      align-items: center;
      width: 100%;
    }
    .special-orders__btn {
      width: 100%;
      max-width: 320px;
    }
  }
</style>

<script>
  const specialOrders = document.querySelector<HTMLElement>(".special-orders");

  if (specialOrders && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const specialOrdersObserver = new IntersectionObserver(
      ([entry], observer) => {
        if (!entry.isIntersecting) return;
        specialOrders.classList.add("is-visible");
        observer.disconnect();
      },
      { threshold: 0.2 },
    );

    specialOrdersObserver.observe(specialOrders);
  }
</script>
