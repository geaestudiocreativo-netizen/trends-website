---
import { cakes } from "../data/cakes";
import { site, waLink } from "../data/site";
import CakeCard from "./CakeCard.astro";

const orderLink = waLink(site.whatsappDefaultMessage);
---
<section class="section catalogue" id="catalogo" aria-label="Nuestras tartas">
  <div class="container">
    <div class="catalogue__intro">
      <h2 class="catalogue__intro-heading">Nuestras tartas</h2>
      <p class="catalogue__intro-body">
        En mi casa, el postre siempre tuvo su momento. Y quizá por eso aprendí que siempre hay que dejar un huequito para lo que nos hace felices.
      </p>
    </div>
    <div class="catalogue__carousel">
      <button class="catalogue__nav" type="button" aria-label="Tartas anteriores" data-catalogue-prev>
        <svg viewBox="0 0 24 24" width="64" height="64" aria-hidden="true">
          <path d="M16 4.5 8.5 12l7.5 7.5" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
      <button class="catalogue__nav catalogue__nav--next" type="button" aria-label="Tartas siguientes" data-catalogue-next>
        <svg viewBox="0 0 24 24" width="64" height="64" aria-hidden="true">
          <path d="m8 4.5 7.5 7.5-7.5 7.5" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
      <div class="catalogue__grid" data-cards>
        {cakes.map((cake, i) => <CakeCard cake={cake} id={`cake-${i}`} index={i} />)}
      </div>
    </div>
    <p class="catalogue__order-intro">Para los momentos que merecen algo más.</p>
    <a class="btn btn--gold catalogue__order" href={orderLink} target="_blank" rel="noopener">
      HACER PEDIDO
    </a>
    <p class="catalogue__notice">Pedidos con 48 h de antelación.</p>

    <div class="catalogue__divider" aria-hidden="true"></div>
  </div>
</section>

<style>
  .catalogue { background: #ffffff; }
  .catalogue__divider {
    display: none;
  }
  .catalogue__grid {
    display: flex;
    flex-direction: column;
  }
  .catalogue__carousel {
    position: relative;
  }
  .catalogue__order {
    display: flex;
    width: fit-content;
    margin: clamp(64px, 8vw, 104px) auto 0;
  }
  .catalogue__order-intro {
    display: none;
  }
  @media (max-width: 640px) {
    .catalogue__order {
      width: 100%;
      max-width: 320px;
    }
  }
  @media (min-width: 1024px) {
    .catalogue__order-intro {
      display: block;
      margin: 160px auto 0;
      font-family: var(--font-sans);
      font-size: 22px;
      font-weight: 700;
      letter-spacing: 0.04em;
      line-height: 1.6;
      color: var(--catalogue-dark);
      text-align: center;
    }
    .catalogue__order {
      width: 260px;
      margin-top: 20px;
    }
  }
  .catalogue__notice {
    margin: 20px auto 0;
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: clamp(0.75rem, 0.95vw, 0.85rem);
    letter-spacing: 0.04em;
    line-height: 1.6;
    color: var(--catalogue-dark);
    text-align: center;
  }
  .catalogue__nav {
    display: none;
  }
  .catalogue__intro {
    margin-inline: auto;
    padding: clamp(48px, 8vw, 88px) 0 clamp(32px, 5vw, 56px);
    text-align: left;
  }
  .catalogue__intro-heading {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: clamp(28px, 4vw, 42px);
    line-height: 1.25;
    letter-spacing: 0.03em;
    color: var(--catalogue-dark);
  }
  .catalogue__intro-body {
    margin: 16px 0 0;
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: clamp(14px, 0.9vw, 16px);
    line-height: 1.8;
    letter-spacing: 0.01em;
    color: rgba(27, 25, 23, 0.72);
  }
  @media (max-width: 1023px) {
    .catalogue__intro {
      margin-inline: auto;
    }
  }
  @media (max-width: 640px) {
    .catalogue__intro {
      padding-bottom: 120px;
      text-align: center;
    }
    .catalogue__intro-heading {
      display: none;
    }
  }
  @media (min-width: 1024px) {
    .catalogue {
      /* Anchors the divider to the exact bottom edge of this section, i.e. the boundary with Services. */
      position: relative;
      padding-top: 0;
    }
    .catalogue__intro {
      display: none;
    }
  }
  @media (min-width: 1024px) {
    .catalogue__intro {
      margin-inline: calc(var(--gutter) * -1 + 40px);
      padding-top: clamp(56px, 6vw, 88px);
      padding-bottom: clamp(32px, 3vw, 48px);
    }
    .catalogue__intro-heading,
    .catalogue__intro-body {
      font-family: var(--font-sans);
      color: var(--catalogue-dark);
    }
    .catalogue__intro-heading {
      font-size: clamp(24px, 2.2vw, 34px);
      line-height: 1.2;
      font-weight: 500;
    }
    .catalogue__intro-body {
      margin-top: 12px;
      font-family: var(--font-sans);
      font-size: clamp(14px, 0.9vw, 16px);
      line-height: 1.8;
      letter-spacing: 0.01em;
      color: rgba(27, 25, 23, 0.72);
    }
  }
  .catalogue__grid :global(.card) {
    padding-block: clamp(48px, 8vw, 88px);
    position: relative;
  }
  .catalogue__grid :global(.card:first-child) {
    padding-top: 0;
  }
  .catalogue__grid :global(.card)::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: calc(var(--gutter) * -1);
    width: calc(100% + var(--gutter) * 2);
    height: 0.5px;
    background: var(--catalogue-dark);
  }
  .catalogue__grid :global(.card:last-child)::after {
    content: none;
  }

  /* Desktop/tablet-landscape: a compact, proportioned product grid
     instead of the full-bleed vertical list used on mobile. Flex (not
     CSS Grid) so an incomplete last row of cards auto-centers via
     justify-content instead of trailing to one side. */
  @media (min-width: 1024px) {
    .catalogue__carousel {
      width: 100vw;
      margin-left: calc((100% - 100vw) / 2);
      margin-right: calc((100% - 100vw) / 2);
    }
    .catalogue__grid {
      display: flex;
      flex-direction: row;
      flex-wrap: nowrap;
      justify-content: flex-start;
      /* Prevents flex's default "stretch": each card keeps its own
         content height instead of matching the tallest in its row. */
      align-items: start;
      gap: clamp(14px, 1.5vw, 24px);
      overflow: hidden;
    }
    .catalogue__grid :global(.card) {
      flex: 0 0 calc((100% - clamp(28px, 3vw, 48px) * 2) / 3 - 148px);
      min-width: 280px;
      padding-block: 0;
      scroll-snap-align: start;
      transform: translateX(var(--cards-offset, 0px));
      transition: transform var(--dur) var(--ease);
    }
    .catalogue__grid :global(.card)::after {
      content: none;
    }
    .catalogue__nav {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      left: 0;
      z-index: 2;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 36px;
      height: 36px;
      padding: 0;
      border: 0;
      color: #000000;
      background: #ffffff;
      border-radius: 0;
      cursor: pointer;
      filter: none;
    }
    .catalogue__nav--next {
      left: auto;
      right: 0;
      width: 36px;
      height: 36px;
    }
    .catalogue__nav:hover,
    .catalogue__nav:focus-visible {
      opacity: 1;
      color: #8a8580;
      background: #ffffff;
    }
    .catalogue__nav[hidden] {
      display: none;
    }
    .catalogue__nav svg {
      display: block;
      width: 32px;
      height: 32px;
    }
  }
</style>

<script>
  // ── Cake cards: allow multiple cards to stay expanded ──────────
  const grid = document.querySelector<HTMLElement>("[data-cards]");
  if (grid) {
    if (window.matchMedia("(min-width: 1024px)").matches) {
      grid.scrollLeft = 0;
    }
    const cataloguePrev = document.querySelector<HTMLButtonElement>("[data-catalogue-prev]");
    const catalogueNext = document.querySelector<HTMLButtonElement>("[data-catalogue-next]");
    const firstCard = grid.querySelector<HTMLElement>(".card");
    const carousel = grid.parentElement;
    const positionCatalogueArrows = () => {
      const media = firstCard?.querySelector<HTMLElement>(".card__media");
      if (!carousel || !media) return;
      const carouselTop = carousel.getBoundingClientRect().top;
      const mediaRect = media.getBoundingClientRect();
      const imageCenter = mediaRect.top + mediaRect.height / 2;
      const top = `${imageCenter - carouselTop}px`;
      if (cataloguePrev) cataloguePrev.style.top = top;
      if (catalogueNext) catalogueNext.style.top = top;
    };
    positionCatalogueArrows();
    window.addEventListener("resize", positionCatalogueArrows);
    let revealPrevAfterScroll = false;
    let carouselOffset = 0;
    const updateCatalogueNav = () => {
      if (!cataloguePrev || !firstCard) return;
      const maxScroll = grid.scrollWidth - grid.clientWidth;
      if (revealPrevAfterScroll && carouselOffset <= 2) return;
      revealPrevAfterScroll = false;
      cataloguePrev.hidden = false;
      if (catalogueNext) catalogueNext.hidden = false;
    };
    const scrollByCard = (direction: number) => {
      const firstCard = grid.querySelector<HTMLElement>(".card");
      if (!firstCard) return;
      const gap = Number.parseFloat(getComputedStyle(grid).columnGap) || 0;
      const step = firstCard.getBoundingClientRect().width + gap;
      const maxScroll = grid.scrollWidth - grid.clientWidth;
      const nextScroll = carouselOffset + direction * step;
      const target = direction > 0 && carouselOffset >= maxScroll - 2
        ? 0
        : direction < 0 && carouselOffset <= 2
          ? maxScroll
          : Math.max(0, Math.min(nextScroll, maxScroll));
      carouselOffset = target;
      grid.style.setProperty("--cards-offset", `${-target}px`);
      updateCatalogueNav();
    };
    if (cataloguePrev) {
      cataloguePrev.addEventListener("click", () => scrollByCard(-1));
    }
    if (catalogueNext) {
      catalogueNext.addEventListener("click", () => {
        revealPrevAfterScroll = true;
        if (cataloguePrev) cataloguePrev.hidden = false;
        scrollByCard(1);
      });
    }
    updateCatalogueNav();

    const heads = Array.from(grid.querySelectorAll<HTMLButtonElement>(".card__head"));
    heads.forEach((head) => {
      head.addEventListener("click", () => {
        const open = head.getAttribute("aria-expanded") === "true";
        head.setAttribute("aria-expanded", open ? "false" : "true");
      });
    });
    // ── Circular galleries: JS-driven position (not native scroll), so every
    // slide can navigate both directions, wrapping past the first/last slide. ──
    const galleries = Array.from(grid.querySelectorAll<HTMLElement>(".card__gallery"));
    galleries.forEach((gallery) => {
      // Progress track is a later sibling of the gallery within .card__media,
      // not the immediately-next element (the nav arrows sit in between).
      const media = gallery.parentElement;
      const progressTrack = media?.querySelector<HTMLElement>(".card__gallery-progress") ?? null;
      const fill = progressTrack?.querySelector<HTMLElement>(".card__gallery-progress-fill") ?? null;
      // The slides live in a separate inner track so the transform moves them
      // inside a stationary, clipped viewport (.card__gallery) instead of moving
      // the viewport itself off-frame (which produced a blank gap).
      const slidesTrack = gallery.querySelector<HTMLElement>(".card__gallery-track");
      const realSlides = slidesTrack ? Array.from(slidesTrack.children) : [];
      const count = realSlides.length;
      if (!progressTrack || !fill || !slidesTrack || count < 2) return;

      const trackWidth = progressTrack.clientWidth;
      const fillWidth = trackWidth / count;
      fill.style.width = `${fillWidth}px`;

      // Infinite-track illusion: clone the first/last slide onto the opposite
      // ends of the track. NEXT always moves further left and PREVIOUS always
      // moves further right — including across the wrap — by animating onto a
      // clone (pixel-identical to the real slide it wraps to), then instantly
      // (no transition) snapping onto that real slide once settled, which is
      // imperceptible since the clone and the real slide look identical.
      const firstClone = realSlides[0].cloneNode(true) as HTMLElement;
      const lastClone = realSlides[count - 1].cloneNode(true) as HTMLElement;
      firstClone.setAttribute("aria-hidden", "true");
      lastClone.setAttribute("aria-hidden", "true");
      slidesTrack.appendChild(firstClone);
      slidesTrack.insertBefore(lastClone, realSlides[0]);

      // Track position includes the two clones: 0 = lastClone, 1..count = the
      // real slides, count+1 = firstClone. `index` is the real (0-based) slide.
      let index = 0;
      let position = 1;

      const setPosition = (animate: boolean, pos: number) => {
        if (animate) {
          slidesTrack.style.transition = "";
        } else {
          slidesTrack.style.transition = "none";
        }
        slidesTrack.style.transform = `translateX(-${pos * 100}%)`;
        if (!animate) {
          // Commits the jump before any later animated transform is applied,
          // otherwise the browser can animate across the jump itself.
          void slidesTrack.offsetWidth;
        }
      };
      const updateFill = () => {
        fill.style.transform = `translateX(${index * fillWidth}px)`;
      };
      setPosition(false, position);
      updateFill();

      // If we're currently resting on a clone, snap back onto the matching
      // real slide (no-op otherwise).
      const settle = () => {
        if (position === 0) {
          position = count;
          setPosition(false, position);
        } else if (position === count + 1) {
          position = 1;
          setPosition(false, position);
        }
      };

      // Deterministic settle timer instead of `transitionend`, which can be
      // skipped/unreliable (e.g. an interrupted transition never fires it).
      let settleTimer: ReturnType<typeof setTimeout> | undefined;
      const scheduleSettle = () => {
        if (settleTimer) clearTimeout(settleTimer);
        settleTimer = setTimeout(settle, 450);
      };

      const render = (animate: boolean) => {
        setPosition(animate, position);
        updateFill();
      };

      const goTo = (dir: 1 | -1) => {
        settle();
        index = ((index + dir) % count + count) % count;
        position += dir;
        updateArrowVisibility();
        setPosition(true, position);
        updateFill();
        scheduleSettle();
      };

      // ── Desktop-only nav arrows: step one slide per click/keypress, wrapping at both ends ──
      const arrows = Array.from(media?.querySelectorAll<HTMLElement>(".card__gallery-arrow") ?? []);
      const previousArrow = arrows.find((arrow) => arrow.dataset.dir === "-1");
      const nextArrow = arrows.find((arrow) => arrow.dataset.dir === "1");
      const updateArrowVisibility = () => {
        if (previousArrow) previousArrow.hidden = index === 0;
        if (nextArrow) nextArrow.hidden = false;
      };
      updateArrowVisibility();
      arrows.forEach((arrow) => {
        const dir = (Number(arrow.dataset.dir) || 0) as 1 | -1;
        const step = () => goTo(dir);
        arrow.addEventListener("click", (event) => {
          event.stopPropagation();
          step();
        });
        arrow.addEventListener("keydown", (event) => {
          if (event.key === "Enter" || event.key === " ") {
            event.preventDefault();
            event.stopPropagation();
            step();
          }
        });
      });

      // ── Swipe/drag: Pointer Events cover touch, mouse and pen with one code path,
      // so dragging always works regardless of input device. Snaps to the nearest
      // slide (wrapping past either end) on release. ──
      let startX = 0;
      let currentX = 0;
      let dragging = false;
      let pointerId: number | null = null;

      const onPointerDown = (event: PointerEvent) => {
        if (event.pointerType === "mouse" && event.button !== 0) return;
        // Prevent the browser's native image-drag gesture from hijacking the
        // pointer (it fires pointercancel almost immediately otherwise).
        if (event.pointerType === "mouse") event.preventDefault();
        settle();
        dragging = true;
        pointerId = event.pointerId;
        startX = currentX = event.clientX;
        slidesTrack.style.transition = "none";
        gallery.setPointerCapture(pointerId);
      };

      const onPointerMove = (event: PointerEvent) => {
        if (!dragging || event.pointerId !== pointerId) return;
        currentX = event.clientX;
        const deltaPercent = ((currentX - startX) / gallery.clientWidth) * 100;
        slidesTrack.style.transform = `translateX(calc(-${position * 100}% + ${deltaPercent}%))`;
      };

      const endDrag = (event: PointerEvent) => {
        if (!dragging || event.pointerId !== pointerId) return;
        dragging = false;
        const deltaX = currentX - startX;
        const threshold = gallery.clientWidth * 0.15;
        if (deltaX <= -threshold) {
          goTo(1);
        } else if (deltaX >= threshold) {
          goTo(-1);
        } else {
          render(true);
        }
      };

      gallery.addEventListener("pointerdown", onPointerDown);
      gallery.addEventListener("pointermove", onPointerMove);
      gallery.addEventListener("pointerup", endDrag);
      gallery.addEventListener("pointercancel", endDrag);
    });
  }
</script>
