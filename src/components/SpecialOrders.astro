---
import { site, waLink } from "../data/site";

const message = site.whatsappDefaultMessage;
const telHref = `tel:+${site.whatsappNumber}`;
---
<section id="contacto" class="special-orders" aria-labelledby="special-orders-title">
  <div class="special-orders__inner">
    <h2 class="special-orders__heading" id="special-orders-title">¿Y SI QUIERO<br />UNA TARTA<br />DIFERENTE?</h2>

    <p class="special-orders__body">Para una celebración, un encargo especial o simplemente porque tienes una idea en mente.</p>

    <p class="special-orders__hint">Para pedidos y consultas, escríbenos por WhatsApp o llámanos.</p>

    <div class="special-orders__actions">
      <a class="btn btn--gold special-orders__btn" href={waLink(message)} target="_blank" rel="noopener">
        Hacer un encargo
      </a>
      <a class="btn btn--light special-orders__btn" href={telHref}>
        Llamar por teléfono
      </a>
    </div>

    <p class="special-orders__notice">Pedidos con 48 h de antelación.</p>
  </div>
</section>

<style>
  .special-orders {
    background: var(--cream-hero);
    padding-block: clamp(120px, 14vw, 168px);
  }

  @media (min-width: 1024px) {
    .special-orders {
      background: #ffffff;
    }
  }

  .special-orders__inner {
    max-width: 560px;
    margin-inline: auto;
    padding-inline: clamp(20px, 6vw, 40px);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .special-orders__heading {
    /* Satoshi isn't loaded in this project; falls back to Poppins Light (300), already loaded. */
    font-family: var(--font-sans);
    font-size: clamp(1.75rem, 4.5vw, 2.75rem);
    font-weight: 300;
    text-transform: none;
    letter-spacing: 0.01em;
    line-height: 1.25;
    color: var(--catalogue-dark);
    margin: 0 0 28px;
  }

  @media (min-width: 1024px) {
    .special-orders__inner {
      /* Widened so the intro paragraph below has room to fit its own single-line max-width. */
      max-width: 840px;
    }
  }

  .special-orders__body,
  .special-orders__hint {
    font-family: "Montserrat", var(--font-sans);
    font-weight: 300;
    font-size: clamp(0.9rem, 1vw, 1rem);
    line-height: 1.7;
    color: var(--brown);
    opacity: 0.78;
    width: 100%;
    max-width: clamp(420px, 54vw, 640px);
    margin: 0 auto 18px;
  }

  @media (min-width: 1024px) {
    .special-orders__body {
      /* Wide enough to keep the full sentence on one line at the desktop font size. */
      max-width: 780px;
    }
  }

  .special-orders__notice {
    /* Satoshi isn't loaded in this project; falls back to Poppins Light (300), already loaded. */
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: clamp(0.75rem, 0.95vw, 0.85rem);
    letter-spacing: 0.04em;
    line-height: 1.6;
    color: var(--catalogue-dark);
    margin: 24px 0 0;
  }

  .special-orders__hint {
    margin-bottom: 36px;
  }

  .special-orders__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
  }

  .special-orders__btn {
    padding-inline: 32px;
  }

  @media (max-width: 640px) {
    .special-orders {
      padding-block: 40px 96px;
    }
    .special-orders__actions {
      flex-direction: column;
      align-items: center;
      width: 100%;
    }
    .special-orders__btn {
      width: 100%;
      max-width: 320px;
    }
  }
</style>
