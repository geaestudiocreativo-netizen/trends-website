---
interface Props {
  class?: string;
  label?: string;
}

const { class: className = "", label = ".G" } = Astro.props;
---

<span class:list={["brand-mark", className]} role="img" aria-label={label}>
  <picture class="brand-mark__picture" aria-hidden="true">
    <img class="brand-mark__image" src="/assets/logos/logo.png" alt="" loading="eager" decoding="async" />
  </picture>
</span>

<style>
  .brand-mark {
    display: inline-block;
    color: inherit;
    font: inherit;
    line-height: 1;
    letter-spacing: inherit;
    vertical-align: baseline;
  }

  .brand-mark__picture {
    display: block;
    line-height: 0;
  }

  .brand-mark__image {
    display: block;
    height: 1em;
    width: auto;
    max-width: none;
  }
</style>