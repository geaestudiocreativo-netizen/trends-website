---
import { site, waLink } from "../data/site";
import WhatsAppIcon from "./WhatsAppIcon.astro";

const message = site.whatsappDefaultMessage;
---
<section id="contacto" class="special-orders" aria-labelledby="special-orders-title">
  <div class="special-orders__inner">
    <p class="special-orders__eyebrow">ENCARGOS ESPECIALES</p>
    <h2 class="special-orders__heading" id="special-orders-title">¿Y SI TU TARTA FUERA OTRA?</h2>
    <p class="special-orders__body">
      Para una celebración, un encargo especial o simplemente porque tienes una idea en la cabeza.
      <br /><br />
      Cuéntanos qué necesitas. Nos gusta escuchar primero y crear después.
    </p>
    <a class="btn btn--gold special-orders__btn" href={waLink(message)} target="_blank" rel="noopener">
      <WhatsAppIcon size={17} /> Hacer un encargo
    </a>
  </div>
</section>

<style>
  .special-orders {
    background: var(--cream-hero);
    padding-block: clamp(140px, 15vw, 180px);
  }

  .special-orders__inner {
    max-width: 560px;
    margin-inline: auto;
    padding-inline: clamp(20px, 6vw, 40px);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .special-orders__eyebrow {
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--olive-dark);
    margin: 0 0 20px;
  }

  .special-orders__heading {
    font-family: "Montserrat", var(--font-sans);
    font-size: clamp(1.4rem, 3.2vw, 2.1rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    line-height: 1.1;
    color: var(--brown);
    margin: 0 0 28px;
  }

  @media (min-width: 1024px) {
    .special-orders__inner {
      max-width: 760px;
    }

    .special-orders__heading {
      white-space: nowrap;
    }
  }

  .special-orders__body {
    font-size: clamp(0.88rem, 1.2vw, 1rem);
    line-height: 1.8;
    color: var(--brown);
    width: 100%;
    max-width: clamp(440px, 58vw, 860px);
    margin: 0 0 40px;
    opacity: 0.82;
  }

  .special-orders__btn {
    padding-inline: 32px;
  }

  @media (max-width: 640px) {
    .special-orders {
      padding-block: 108px;
    }
    .special-orders__btn {
      width: 100%;
      max-width: 320px;
    }
  }
</style>
