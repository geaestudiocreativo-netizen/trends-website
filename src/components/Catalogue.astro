---
import { cakes } from "../data/cakes";
import CakeCard from "./CakeCard.astro";

const beforeBreak = cakes.slice(0, 2);
const afterBreak = cakes.slice(2);
---
<section class="section catalogue" id="catalogo" aria-label="Nuestras tartas">
  <div class="container">
    <div class="catalogue__grid" data-cards>
      {beforeBreak.map((cake, i) => <CakeCard cake={cake} id={`cake-${i}`} index={i} />)}

      <div class="catalogue__break">
        <div class="catalogue__break-inner">
          <p class="catalogue__break-heading">
            Una buena tarta<br class="catalogue__break-heading-break--mobile" />
            no es solo un postre.
          </p>
          <p class="catalogue__break-body">Es una mesa que se llena y una<br class="catalogue__break-body-break--mobile" />sobremesa que se alarga.</p>
        </div>
      </div>

      {afterBreak.map((cake, i) => <CakeCard cake={cake} id={`cake-${i + 2}`} index={i + 2} />)}
    </div>
  </div>
</section>

<style>
  .catalogue { background: var(--cream-hero); }
  .catalogue__grid {
    display: flex;
    flex-direction: column;
  }
  .catalogue__break {
    width: calc(100% + var(--gutter) * 2);
    margin-inline: calc(var(--gutter) * -1);
    background: var(--catalogue-dark);
    padding-block: clamp(96px, 14vw, 160px);
    display: flex;
    justify-content: center;
  }
  .catalogue__break-inner {
    max-width: 460px;
    padding-inline: var(--gutter);
    text-align: center;
  }
  @media (min-width: 1024px) {
    .catalogue__break {
      width: fit-content;
      max-width: 1200px;
      margin-inline: auto;
      padding-block: clamp(28px, 4vw, 48px);
      align-items: center;
    }
    .catalogue__break-inner {
      max-width: none;
      padding-inline: clamp(32px, 3vw, 56px);
    }
    .catalogue__break-heading-break--mobile,
    .catalogue__break-body-break--mobile {
      display: none;
    }
    .catalogue__break-heading,
    .catalogue__break-body {
      white-space: nowrap;
    }
  }
  .catalogue__break-heading {
    margin: 0;
    /* Satoshi isn't loaded in this project; falls back to Poppins Light (300), already loaded. */
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: clamp(28px, 4vw, 42px);
    line-height: 1.25;
    letter-spacing: 0.03em;
    color: var(--cream-hero);
  }
  .catalogue__break-body {
    margin: 28px 0 0;
    font-family: "Montserrat", var(--font-sans);
    font-weight: 300;
    font-size: clamp(14px, 0.9vw, 16px);
    line-height: 1.8;
    letter-spacing: 0.01em;
    color: rgba(255, 250, 244, 0.72);
  }
  @media (min-width: 1024px) {
    .catalogue__break {
      grid-column: 1 / -1;
    }
  }
  .catalogue__grid :global(.card) {
    padding-block: clamp(48px, 8vw, 88px);
    position: relative;
  }
  .catalogue__grid :global(.card:first-child) {
    padding-top: 0;
  }
  .catalogue__grid :global(.card)::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: calc(var(--gutter) * -1);
    width: calc(100% + var(--gutter) * 2);
    height: 0.5px;
    background: var(--catalogue-dark);
  }

  /* Desktop/tablet-landscape: a compact, proportioned product grid
     instead of the full-bleed vertical list used on mobile. */
  @media (min-width: 1024px) {
    .catalogue__grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      /* Prevents grid's default "stretch": each card keeps its own
         content height instead of matching the tallest in its row. */
      align-items: start;
      --row-gap: clamp(32px, 3.4vw, 56px);
      gap: var(--row-gap) clamp(28px, 3vw, 48px);
    }
    .catalogue__grid :global(.card) {
      padding-block: 0;
    }
    .catalogue__grid :global(.card)::after {
      content: none;
    }
  }
</style>

<script>
  // ── Cake cards: expand one at a time ───────────────────────────
  const grid = document.querySelector<HTMLElement>("[data-cards]");
  if (grid) {
    const heads = Array.from(grid.querySelectorAll<HTMLButtonElement>(".card__head"));
    heads.forEach((head) => {
      head.addEventListener("click", () => {
        const open = head.getAttribute("aria-expanded") === "true";
        heads.forEach((h) => h.setAttribute("aria-expanded", "false"));
        head.setAttribute("aria-expanded", open ? "false" : "true");
      });
    });

    // ── Swipe galleries: thin progress line tracks scroll position ──
    const galleries = Array.from(grid.querySelectorAll<HTMLElement>(".card__gallery"));
    galleries.forEach((gallery) => {
      const track = gallery.nextElementSibling as HTMLElement | null;
      const fill = track?.classList.contains("card__gallery-progress")
        ? track.querySelector<HTMLElement>(".card__gallery-progress-fill")
        : null;
      const count = gallery.children.length;
      if (!track || !fill || count < 2) return;

      const trackWidth = track.clientWidth;
      const fillWidth = trackWidth / count;
      fill.style.width = `${fillWidth}px`;

      const update = () => {
        const max = gallery.scrollWidth - gallery.clientWidth;
        const ratio = max > 0 ? gallery.scrollLeft / max : 0;
        fill.style.transform = `translateX(${ratio * (trackWidth - fillWidth)}px)`;
      };
      update();
      gallery.addEventListener("scroll", update, { passive: true });

      // ── Desktop-only nav arrows: step one slide per click/keypress ──
      const media = gallery.parentElement;
      const arrows = Array.from(media?.querySelectorAll<HTMLElement>(".card__gallery-arrow") ?? []);
      arrows.forEach((arrow) => {
        const dir = Number(arrow.dataset.dir) || 0;
        const step = () => gallery.scrollBy({ left: dir * gallery.clientWidth, behavior: "smooth" });
        arrow.addEventListener("click", (event) => {
          event.stopPropagation();
          step();
        });
        arrow.addEventListener("keydown", (event) => {
          if (event.key === "Enter" || event.key === " ") {
            event.preventDefault();
            event.stopPropagation();
            step();
          }
        });
      });
    });
  }
</script>
