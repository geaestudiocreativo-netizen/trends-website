---
import { site } from "../data/site";
const imagePath = (assetPath: string) => `${import.meta.env.BASE_URL}${assetPath}`;

const heroDesktopAvifSrcset = `${imagePath("images/hero/hero-1280.avif")} 1280w, ${imagePath("images/hero/hero-1920.avif")} 1920w, ${imagePath("images/hero/hero-2560.avif")} 2560w`;
const heroDesktopWebpSrcset = `${imagePath("images/hero/hero-1280.webp")} 1280w, ${imagePath("images/hero/hero-1920.webp")} 1920w, ${imagePath("images/hero/hero-2560.webp")} 2560w`;
const heroDesktopJpegSrcset = `${imagePath("images/hero/hero-1280.jpg")} 1280w, ${imagePath("images/hero/hero-1920.jpg")} 1920w, ${imagePath("images/hero/hero-2560.jpg")} 2560w`;

const heroMobileWebpSrcset = `${imagePath("images/hero/hero-mobile-640.webp")} 640w, ${imagePath("images/hero/hero-mobile-960.webp")} 960w, ${imagePath("images/hero/hero-mobile-1280.webp")} 1280w`;
const heroMobileJpegSrcset = `${imagePath("images/hero/hero-mobile-640.jpg")} 640w, ${imagePath("images/hero/hero-mobile-960.jpg")} 960w, ${imagePath("images/hero/hero-mobile-1280.jpg")} 1280w`;
---
<header class="hero" id="top">
  <picture class="hero__media" aria-hidden="true">
    <source
      media="(max-width: 640px)"
      type="image/webp"
      srcset={heroMobileWebpSrcset}
      sizes="100vw"
    />
    <source
      media="(max-width: 640px)"
      type="image/jpeg"
      srcset={heroMobileJpegSrcset}
      sizes="100vw"
    />
    <source type="image/avif" srcset={heroDesktopAvifSrcset} sizes="100vw" />
    <source type="image/webp" srcset={heroDesktopWebpSrcset} sizes="100vw" />
    <img
      class="hero__img"
      src={imagePath("images/hero/hero-1920.jpg")}
      srcset={heroDesktopJpegSrcset}
      sizes="100vw"
      alt=""
      width="6240"
      height="4160"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </picture>
  <div class="hero__scrim" aria-hidden="true"></div>
  <div class="hero__inner container">
    <div class="hero__brand">
      <svg class="hero__mark hero-in" viewBox="0 0 241 201" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <circle cx="21.5" cy="178.5" r="21.5" fill="var(--catalogue-dark)" />
        <path d="M54.0023 120.266C54.0023 109.523 56.0205 99.4974 60.057 90.1875C64.0935 80.8125 69.9854 72.6745 77.7328 65.7734C85.4802 58.8724 94.9854 53.4362 106.248 49.4648C117.577 45.4935 130.532 43.5078 145.116 43.5078C150.389 43.5078 155.662 43.8008 160.936 44.3867C166.274 44.9076 171.515 45.7539 176.659 46.9258C181.867 48.0977 186.912 49.5951 191.795 51.418C196.743 53.1758 201.431 55.2917 205.858 57.7656L191.6 81.2031C188.931 79.6406 185.903 78.2409 182.518 77.0039C179.133 75.7018 175.487 74.6276 171.58 73.7812C167.739 72.8698 163.735 72.1862 159.569 71.7305C155.467 71.2747 151.333 71.0469 147.166 71.0469C137.531 71.0469 128.937 72.2839 121.385 74.7578C113.833 77.1667 107.453 80.5846 102.245 85.0117C97.0362 89.3737 93.0648 94.6146 90.3304 100.734C87.5961 106.854 86.2289 113.56 86.2289 120.852C86.2289 128.404 87.6612 135.337 90.5258 141.652C93.3903 147.967 97.4594 153.404 102.733 157.961C108.006 162.518 114.386 166.099 121.873 168.703C129.36 171.242 137.726 172.512 146.971 172.512C154.328 172.512 161.066 171.698 167.186 170.07C173.306 168.378 178.644 166.001 183.202 162.941C187.759 159.882 191.47 156.203 194.334 151.906C197.199 147.544 199.087 142.661 199.998 137.258H146.678V111.77H227.83V111.867L227.928 111.77C229.556 119.582 230.044 127.199 229.393 134.621C228.807 141.978 227.114 148.944 224.315 155.52C221.58 162.03 217.804 168.02 212.987 173.488C208.169 178.957 202.407 183.677 195.702 187.648C188.996 191.555 181.379 194.615 172.85 196.828C164.321 198.977 154.979 200.051 144.823 200.051C130.63 200.051 117.902 197.967 106.639 193.801C95.4411 189.634 85.9359 183.938 78.1234 176.711C70.3109 169.484 64.3213 161.021 60.1547 151.32C56.0531 141.62 54.0023 131.268 54.0023 120.266Z" fill="var(--catalogue-dark)" />
      </svg>
      <h1 class="hero__title hero-in">Tartas de autor en Las Rozas</h1>
      <p class="hero__description hero-in">
        Una buena tarta no es solo un postre.<br />
        Es una mesa que se llena y una sobremesa que se alarga.
      </p>
      <p class="hero__byline hero-in">{site.tagline}</p>
    </div>
  </div>
</header>

<style>
  /* ── shell ──────────────────────────────────────────────
     Photograph is the background at EVERY breakpoint; the
     text is overlaid on top of it (never stacked below).   */
  .hero {
    position: relative;
    /* Clean loading state: flat brand cream shows until the photograph
       paints. No JS, no animation — just the section's own colour. */
    background-color: var(--cream-hero);
    /* Clean base while the photograph loads — flat colour, no old content. */
    background-color: var(--cream-hero);
    min-height: clamp(640px, 90vh, 960px);
    min-height: clamp(640px, 90svh, 960px);
    display: grid;
    place-items: start center;
    padding-block: clamp(72px, 14vh, 140px) clamp(88px, 14vh, 172px);
    overflow: hidden;
    isolation: isolate;
  }

  /* Parallax layer. Kept separate from .hero__bg so the scroll
     transform never competes with the intro scale animation.
     Vertical slack (-7%) means the drift can never expose an edge. */
  .hero__media {
    position: absolute;
    inset: -7% 0;
    z-index: -2;
    will-change: transform;
  }
  /* Single hero asset — src comes from src/data/site.ts.
     Swap public/images/hero.jpg to change it; no code edits.
     A content fingerprint on the URL (see site.ts) is what prevents a
     stale cached bitmap, so visibility never depends on JavaScript. */
  .hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Portrait photo: on the wide desktop crop, bias upward so the
       whisk-and-bowl stay in frame rather than the blurred counter.
       Mobile shows nearly the full frame, so it stays centred (below). */
    object-position: center center;
    transform: scale(1);
    transform-origin: center;
    will-change: transform, opacity;
    opacity: 1;
  }

  /* Soft cream veil so the dark logo stays legible on a bright photo. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to right,
      rgba(255, 250, 244, 0.04) 0%,
      rgba(255, 250, 244, 0.1) 52%,
      rgba(255, 250, 244, 0.18) 100%
    );
  }

  /* The photograph ends on a clean, defined edge — the Services
     section begins immediately below it. No blending between them. */

  /* ── content ────────────────────────────────────────── */
  .hero__inner {
    padding-inline: clamp(20px, 7.6vw, 110px);
    max-width: none;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }
  .hero__brand {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .hero__mark {
    display: block;
    width: auto;
    height: clamp(44px, 6vw, 64px);
    max-width: 100%;
  }
  .hero__title,
  .hero__description {
    margin: 0;
    color: var(--catalogue-dark);
    text-align: center;
  }
  .hero__title {
    margin-top: clamp(20px, 2.6vw, 32px);
    font-family: var(--font-sans);
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0;
  }
  .hero__description {
    margin-top: clamp(20px, 2.8vw, 34px);
    width: min(100%, 430px);
    max-width: 430px;
    font-family: var(--font-sans);
    font-size: clamp(0.78rem, 1.1vw, 1rem);
    font-weight: 300;
    line-height: 1.8;
    letter-spacing: 0.12em;
  }
  .hero__description br { display: none; }
  .hero__byline {
    /* Close coupling with the mark above — reads as a signature, not a stacked headline. */
    margin-top: clamp(18px, 2.2vw, 28px);
    margin-bottom: 0;
    /* Satoshi isn't loaded in this project; falls back to Poppins Light (300), already loaded. */
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: clamp(11px, 1vw, 13px);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--catalogue-dark);
    opacity: 0.72;
    text-align: center;
  }
  .hero__eyebrow {
    font-size: clamp(0.72rem, 1.1vw, 0.95rem);
    letter-spacing: 0.22em;
    color: var(--catalogue-dark);
    font-weight: 300;
    /* Wider gap sets it apart as a caption tier, distinct from the signature above. */
    margin-top: clamp(40px, 5.5vw, 64px);
    margin-bottom: 0;
    text-align: center;
  }

  /* ── entrance ──────────────────────────────────────── */
  /* Restrained parallax: the photograph drifts at roughly a sixth
     of scroll speed. Where scroll-driven animations are supported
     this runs entirely on the compositor — no JS, no scroll handler. */
  @keyframes heroParallax {
    from { transform: translate3d(0, 0, 0); }
    to   { transform: translate3d(0, 6%, 0); }
  }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      .hero__media {
        animation: heroParallax linear both;
        animation-timeline: scroll(root block);
        animation-range: 0 100vh;
      }
    }
  }

  @keyframes heroRise {
    from { opacity: 0; transform: translate3d(0, 14px, 0); }
    to   { opacity: 1; transform: translate3d(0, 0, 0); }
  }
  .hero-in {
    will-change: transform, opacity;
    animation: heroRise 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  .hero__mark.hero-in { animation-delay: 0.15s; }
  .hero__title.hero-in { animation-delay: 0.22s; }
  .hero__description.hero-in { animation-delay: 0.29s; }
  .hero__byline.hero-in { animation-delay: 0.36s; }
  .hero__eyebrow.hero-in  { animation-delay: 0.30s; }

  @media (min-width: 641px) {
    /* Centred editorial lockup — logo, byline and eyebrow all share the
       same horizontal axis, aligned to the centre of the hero image. */
    .hero__inner {
      align-items: center;
      text-align: center;
    }
    .hero__brand { align-items: center; }
  }

  @media (min-width: 1024px) {
    .hero__title {
      font-size: clamp(2rem, 3.2vw, 3.25rem);
      white-space: nowrap;
    }
    .hero__title br { display: none; }
    .hero__description {
      margin-top: clamp(10px, 1.4vw, 18px);
      width: min(100%, 620px);
      max-width: 620px;
    }
    .hero__description br { display: block; }
    .hero__byline { margin-top: clamp(10px, 1.2vw, 16px); }
  }

  /* ── mobile ────────────────────────────────────────────
     Same overlay structure as desktop — only the height and
     the veil direction change. Frame: photo band 0–569.    */
  @media (max-width: 640px) {
    .hero__media {
      display: block;
    }

    /* The photograph owns the first screen: the hero fills almost the
       whole viewport, so Services only appears once the user scrolls. */
    .hero {
      min-height: 92vh;
      min-height: 92svh;
      /* content is anchored in the upper area rather than centred vertically */
      place-items: start center;
      padding-block: clamp(40px, 8vh, 72px) clamp(72px, 14vh, 132px);
    }

    /* Veil peaks behind the type and eases off again before the
       bottom, so the image keeps its density right up to the edge. */
    .hero__scrim {
      background: linear-gradient(
        to bottom,
        rgba(255, 250, 244, 0.02) 0%,
        rgba(255, 250, 244, 0.08) 58%,
        rgba(255, 250, 244, 0.16) 100%
      );
    }

    /* Type sits directly on the photograph now, so a barely-visible
       cream halo keeps it crisp over crumbs and shadows without
       lightening the image itself. */
    .hero__byline,
    .hero__eyebrow {
      text-shadow: 0 1px 14px rgba(255, 250, 244, 0.62);
    }
    .hero__mark {
      filter: drop-shadow(0 1px 14px rgba(255, 250, 244, 0.62));
    }

    /* Mobile shows almost the whole portrait — centre it. */
    .hero__img { object-position: 42% center; }

    .hero__inner {
      text-align: center;
      align-items: center;
    }

    .hero__brand {
      align-items: center;
    }

    .hero__mark {
      height: clamp(36px, 12vw, 48px);
      max-width: 100%;
    }
    .hero__title {
      margin-top: 20px;
      font-size: clamp(2rem, 8vw, 3rem);
    }
    .hero__description {
      margin-top: 20px;
      width: min(100%, 63vw);
      max-width: 378px;
      font-size: 0.76rem;
      line-height: 1.8;
      letter-spacing: 0.1em;
    }
    .hero__byline { margin-top: 18px; }
  }

  /* ── reduced motion ────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .hero__media,
    .hero__img,
    .hero-in {
      animation: none;
      transform: none;
      opacity: 1;
    }
  }
</style>

<script>
  // Parallax fallback for browsers without scroll-driven CSS animations
  // (Safari, Firefox). Chromium handles it on the compositor via the
  // @supports block above, so this never runs there.
  const media = document.querySelector<HTMLElement>(".hero__media");
  const hero = document.querySelector<HTMLElement>(".hero");

  const supportsScrollTimeline =
    typeof CSS !== "undefined" && CSS.supports("animation-timeline: scroll()");

  if (media && hero && !supportsScrollTimeline) {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
    let visible = true;
    let ticking = false;

    const update = () => {
      ticking = false;
      if (reduce.matches || !visible) return;
      const h = hero.offsetHeight || 1;
      // 0 → 1 across the first screenful, then clamp
      const progress = Math.min(Math.max(window.scrollY / h, 0), 1);
      media.style.transform = `translate3d(0, ${(progress * 6).toFixed(3)}%, 0)`;
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };

    // Only listen while the hero is actually on screen.
    if ("IntersectionObserver" in window) {
      new IntersectionObserver(
        ([entry]) => {
          visible = entry.isIntersecting;
        },
        { rootMargin: "10% 0px" }
      ).observe(hero);
    }

    const enable = () => {
      if (reduce.matches) {
        media.style.transform = "";
        window.removeEventListener("scroll", onScroll);
      } else {
        window.addEventListener("scroll", onScroll, { passive: true });
        update();
      }
    };

    enable();
    reduce.addEventListener?.("change", enable);
  }
</script>
