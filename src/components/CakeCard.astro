---
import type { Cake } from "../data/cakes";
import { site, waLink } from "../data/site";
import WhatsAppIcon from "./WhatsAppIcon.astro";

interface Props {
  cake: Cake;
  id: string;
  index: number;
}
const { cake, id, index } = Astro.props;
const num = String(index + 1).padStart(2, "0");
const orderMsg = site.whatsappItemMessage.replace("{item}", cake.name);
const imageBase = cake.image.replace(/\.(?:jpe?g|png)$/i, "");
const webpSrcSet = `${imageBase}-420.webp 420w, ${imageBase}-760.webp 760w, ${imageBase}-1080.webp 1080w`;
const jpegSrcSet = `${imageBase}-420.jpg 420w, ${imageBase}-760.jpg 760w, ${imageBase}-1080.jpg 1080w`;
---
<article class="card" data-card>
  <button
    class="card__head"
    aria-expanded="false"
    aria-controls={`panel-${id}`}
    id={`btn-${id}`}
  >
    <span class="card__media">
      <picture>
        <source type="image/webp" srcset={webpSrcSet} sizes="(max-width: 640px) 100vw, (max-width: 900px) 50vw, 33vw" />
        <img
          src={`${imageBase}-760.jpg`}
          srcset={jpegSrcSet}
          sizes="(max-width: 640px) 100vw, (max-width: 900px) 50vw, 33vw"
          alt={cake.name}
          width="339"
          height="366"
          loading="lazy"
          decoding="async"
        />
      </picture>
    </span>

    <span class="card__body">
      <span class="card__editorial">{num} / {cake.category}</span>
      <span class="card__title-row">
        <span class="card__title">{cake.name}</span>
      </span>
      {cake.description && <span class="card__desc">{cake.description}</span>}
      <span class="card__bottom-row">
        <span></span>
          <span class="card__details">Ver detalles</span>
      </span>
    </span>
  </button>

  <div class="card__panel" id={`panel-${id}`} role="region" aria-labelledby={`btn-${id}`}>
    <div class="card__panel-inner">
      <div class="detail">
        {cake.sizes && cake.sizes.length > 0 && (
          <>
            <h4 class="detail__h">Tamaños y precios</h4>
            <ul class="sizes">
              {cake.sizes.map((s, i) => (
                <li class="size">
                  <span class="size__label">
                    <span class="size-chip" style={`--bg:${i % 2 === 0 ? "#7B8062" : "#4A2928"};--fg:#F7F1E8`}>{s.size}</span>
                  </span>
                  <span class="size__price">{s.price}</span>
                </li>
              ))}
            </ul>
          </>
        )}

        {cake.flavors && cake.flavors.length > 0 && (
          <>
            <h4 class="detail__h">Variedades</h4>
            <ul class="detail__allergens">
              {cake.flavors.map((f) => <li>{f}</li>)}
            </ul>
          </>
        )}

        {cake.allergens && cake.allergens.length > 0 && (
          <>
            <h4 class="detail__h">Alérgenos</h4>
            <ul class="detail__allergens">
              {cake.allergens.map((a) => <li>{a}</li>)}
            </ul>
          </>
        )}

        <a class="btn btn--gold detail__cta" href={waLink(orderMsg)} target="_blank" rel="noopener">
          <WhatsAppIcon size={17} /> Pedir esta tarta
        </a>
      </div>
    </div>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--cream-hero);
    border-radius: 0;
    box-shadow: var(--card-shadow);
    overflow: hidden;
    transition: box-shadow var(--dur) var(--ease), transform var(--dur) var(--ease);
    will-change: transform;
  }
  .card:hover { transform: translateY(-4px); box-shadow: var(--card-shadow-hover); }
  .card:focus-within { box-shadow: var(--card-shadow-hover); }

  .card__head {
    display: flex;
    flex-direction: column;
    width: 100%;
    text-align: left;
    padding: 9px 8px 0;
  }

  .card__media {
    position: relative;
    display: block;
    aspect-ratio: 339 / 366;
    border-radius: 0;
    overflow: hidden;
  }
  .card__media img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform 0.6s var(--ease);
    will-change: transform;
  }
  .card:hover .card__media img { transform: scale(1.05); }
  .card__price {
    position: absolute; top: 0; right: 0;
    background: var(--brown);
    color: var(--cream-hero);
    font-size: 0.76rem; font-weight: 500;
    padding: 6px 14px;
    border-radius: 0 var(--radius-card) 0 10px;
  }
  .card__price::before { content: "desde "; }

  .card__body {
    display: flex;
    flex-direction: column;
    padding: 17px 2px 11px;
  }
  .card__editorial {
    display: block;
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--olive-dark);
    margin-bottom: 4px;
  }
  .card__title-row {
    display: flex;
    min-height: 2.816rem;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
  }
  .card__title {
    font-family: "Montserrat", var(--font-sans);
    font-weight: 600;
    font-size: 1.28rem;
    color: var(--brown);
    line-height: 1.1;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
  .card__sizes { display: inline-flex; gap: 5px; flex-shrink: 0; }
  .card__bottom-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-top: 20px;
    margin-bottom: 16px;
  }
  .size-chip {
    display: inline-grid;
    place-items: center;
    min-width: 52px;
    height: 21px;
    padding-inline: 6px;
    white-space: nowrap;
    border-radius: 5px;
    background: var(--bg, var(--olive));
    color: var(--fg, #fff);
    font-size: 0.68rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0;
  }

  .card__desc {
    display: block;
    min-height: 4rem; /* 3 columns worst case: 3 lines at 0.8rem/1.5lh */
    margin-top: 5px;
    font-size: 0.8rem;
    color: var(--brown);
  }

  @media (max-width: 900px) {
    /* 2 columns: longest desc wraps to ~2 lines */
    .card__desc { min-height: 2.8rem; }
  }

  @media (max-width: 640px) {
    /* 1 column: all descs fit in 1–2 lines */
    .card__desc { min-height: 2rem; }
  }
  .card__sub { display: block; margin-top: 0; font-size: calc(0.66rem + 2px); color: var(--muted); }
  .card__details {
    display: inline-flex;
    align-items: center;
    padding: 5px 10px;
    border: 1px solid #452928;
    border-radius: 100px;
    background: transparent;
    color: #452928;
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    opacity: 0.72;
    transition: opacity var(--dur) var(--ease), background var(--dur) var(--ease);
  }
  .card__head:hover .card__details,
  .card__head:focus-visible .card__details { opacity: 1; background: rgba(69,41,40,0.06); }

  /* expand */
  .card__panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows var(--dur) var(--ease);
  }
  .card__panel-inner {
    overflow: hidden;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity var(--dur) var(--ease), transform var(--dur) var(--ease);
  }
  .card__head[aria-expanded="true"] + .card__panel { grid-template-rows: 1fr; }
  .card__head[aria-expanded="true"] + .card__panel .card__panel-inner { opacity: 1; transform: none; }

  .detail {
    display: flex;
    flex-direction: column;
    padding: 4px 20px 22px;
    border-top: 1px solid var(--hairline);
    margin: 0 4px;
  }
  .card__panel-inner { background: var(--cream-hero); }
  .detail__h {
    font-size: 0.7rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--olive-dark); margin-top: 16px; margin-bottom: 8px;
  }
  .sizes { display: flex; flex-direction: column; gap: 8px; }
  .size { display: flex; justify-content: space-between; align-items: center; gap: 12px; font-size: 0.86rem; }
  .size__label { display: flex; align-items: center; gap: 8px; color: var(--brown); flex-wrap: wrap; }
  .size__code {
    display: inline-grid; place-items: center;
    width: 20px; height: 20px; border-radius: 5px;
    background: var(--bg); color: var(--fg);
    font-size: 0.66rem; font-weight: 600; line-height: 1;
  }
  .size__note { display: block; width: 100%; font-size: 0.7rem; color: var(--muted); font-style: normal; padding-left: 28px; }
  .size__price { color: var(--brown); font-weight: 600; white-space: nowrap; }

  .detail__allergens {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 0.7rem;
    line-height: 1.5;
    color: #6b5c5a;
  }
  .detail__allergens li::before { content: "— "; }

  .detail__storage { font-size: 0.8rem; color: var(--muted); line-height: 1.55; }
  .detail__cta { margin-top: 18px; width: 100%; height: 46px; font-size: 0.9rem; }

  .card.is-hidden { display: none; }

</style>
