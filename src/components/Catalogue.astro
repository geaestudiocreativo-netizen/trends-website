---
import { cakes } from "../data/cakes";
import CakeCard from "./CakeCard.astro";
---
<section class="section catalogue" id="catalogo" aria-labelledby="catalogue-title">
  <div class="container">
    <header class="catalogue__head reveal">
      <h2 class="section-title" id="catalogue-title">Nuestras tartas</h2>
      <p class="eyebrow">Siempre para compartir.</p>
    </header>

    <div class="catalogue__grid" data-cards>
      {cakes.map((cake, i) => <CakeCard cake={cake} id={`cake-${i}`} index={i} />)}
    </div>
  </div>
</section>

<style>
  .catalogue { background: var(--catalogue-dark); }
  .catalogue__head .section-title {
    color: var(--cream-hero);
    /* Satoshi isn't loaded in this project; falls back to Poppins Light (300), already loaded. */
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: clamp(1.5rem, 2.6vw, 2rem);
  }
  .catalogue__head .eyebrow { color: rgba(255, 250, 244, 0.62); }
  .catalogue__head { display: flex; flex-direction: column; gap: 6px; }
  .catalogue__grid {
    margin-top: clamp(32px, 4vw, 48px);
    display: flex;
    flex-direction: column;
  }
  .catalogue__grid :global(.card) {
    padding-block: clamp(48px, 8vw, 88px);
    position: relative;
  }
  .catalogue__grid :global(.card:first-child) {
    padding-top: 0;
  }
  .catalogue__grid :global(.card:not(:last-child))::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: calc(var(--gutter) * -1);
    width: calc(100% + var(--gutter) * 2);
    height: 0.5px;
    background: #fff;
  }

  /* Desktop/tablet-landscape: a compact, proportioned product grid
     instead of the full-bleed vertical list used on mobile. */
  @media (min-width: 1024px) {
    .catalogue__grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      /* Prevents grid's default "stretch": each card keeps its own
         content height instead of matching the tallest in its row. */
      align-items: start;
      --row-gap: clamp(32px, 3.4vw, 56px);
      gap: var(--row-gap) clamp(28px, 3vw, 48px);
    }
    .catalogue__grid :global(.card) {
      padding-block: 0;
    }
    .catalogue__grid :global(.card:not(:last-child))::after {
      content: none;
    }
  }
</style>

<script>
  // ── Cake cards: expand one at a time ───────────────────────────
  const grid = document.querySelector<HTMLElement>("[data-cards]");
  if (grid) {
    const heads = Array.from(grid.querySelectorAll<HTMLButtonElement>(".card__head"));
    heads.forEach((head) => {
      head.addEventListener("click", () => {
        const open = head.getAttribute("aria-expanded") === "true";
        heads.forEach((h) => h.setAttribute("aria-expanded", "false"));
        head.setAttribute("aria-expanded", open ? "false" : "true");
      });
    });
  }
</script>
